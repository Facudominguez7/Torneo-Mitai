# Gentleman Guardian Angel Configuration
# https://github.com/your-org/gga

# AI Provider (required)
PROVIDER="opencode"

# File patterns to include in review (comma-separated)
# PHP para tu backend/controladores, blade.php para tus vistas (HTML + Alpine.js + Tailwind),
# y js/css para tus assets de frontend administrados por Vite.
FILE_PATTERNS="*.php,*.blade.php,*.js,*.css,*.scss"

# File patterns to exclude from review (comma-separated)
# Excluimos los archivos de bloqueo de dependencias, logs y archivos de datos masivos
# ya que la IA no necesita auditarlos y gastarían muchísimo contexto.
EXCLUDE_PATTERNS="composer.lock,package-lock.json,yarn.lock,*.log,*.csv"

# File containing code review rules
RULES_FILE="AGENTS.md"

# Strict mode: fail if AI response is ambiguous
STRICT_MODE="true"

# Timeout in seconds for AI provider response
TIMEOUT="300"

# Base branch for --pr-mode (auto-detects main/master/develop if empty)
# PR_BASE_BRANCH="main"
