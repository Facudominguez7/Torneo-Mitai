{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-escrituras-db.sh",
            "timeout": 10,
            "statusMessage": "Verificando escrituras en la base de desarrollo"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "impeccable@impeccable": true
  }
}
